# Copy to .env and fill in the values locally.
# Keep credentials on the backend and out of logs and source control.
OPENAI_API_KEY=
NCBI_API_KEY=

# Choose the OpenAI model before running model-backed sourcing.
OPENAI_MODEL=gpt-4.1-mini

# Optional contact address for NCBI requests.
NCBI_EMAIL=

# PostgreSQL for host development (Docker Compose overrides the host internally).
DATABASE_URL=postgresql+psycopg://evidence:evidence_local@127.0.0.1:55432/evidence

# Optional local application access token. Never use an upstream API key here.
APP_ACCESS_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
